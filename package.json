		"typescript": "npm:@typescript/typescript6@6.0.2",
		"vite": "8.1.5",
		"vite-plugin-checker": "0.14.4",
		"vite-plugin-solid": "2.11.13",
		"vitest": "4.1.10"
	},
	"packageManager": "bun@1.3.14",
